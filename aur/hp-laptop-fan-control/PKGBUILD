pkgname=hp-laptop-fan-control
pkgver=1.3.0
pkgrel=1
pkgdesc="Fan curve daemon for HP Victus/Omen laptops"
arch=('any')
url="https://github.com/emomaxd/hp-laptop-fan-control"
license=('GPL-2.0-only')
depends=('bash' 'systemd')
optdepends=(
    'inotify-tools: automatic config reload on save'
    'hp-wmi-dkms: patched kernel module for pre-7.1 kernels'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/emomaxd/hp-laptop-fan-control/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "hp-laptop-fan-control-$pkgver"

    install -Dm755 hp-fan-control "$pkgdir/usr/bin/hp-fan-control"
    install -Dm755 hp-fan-curve   "$pkgdir/usr/bin/hp-fan-curve"
    ln -s hp-fan-curve            "$pkgdir/usr/bin/hpf"

    sed "s|HP_FAN_CONTROL_BIN|/usr/bin/hp-fan-control|" hp-fan-control.service \
        | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/hp-fan-control.service"
}
