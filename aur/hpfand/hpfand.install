post_install() {
    systemd-sysusers
    echo "==> Enable and start hpfand:"
    echo "      systemctl enable --now hpfand"
}

post_upgrade() {
    systemd-sysusers
    systemctl daemon-reload
    systemctl try-restart hpfand 2>/dev/null || true
}

pre_remove() {
    systemctl disable --now hpfand 2>/dev/null || true
}
