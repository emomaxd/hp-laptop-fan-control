[Unit]
Description=hpfand — HP Victus/Omen fan curve daemon
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=HPFAND_BIN
Restart=always
RestartSec=3
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
StateDirectory=hpfand
StateDirectoryMode=0777

[Install]
WantedBy=multi-user.target
