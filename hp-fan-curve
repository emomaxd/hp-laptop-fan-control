#!/bin/bash

CONF=/etc/hp-fan-control.conf
SILENT_FLAG=/tmp/hp-fan-silent

usage() {
    cat <<EOF
usage: hp-fan-curve <command>

commands:
  status              live cpu temp, fan rpm, active preset
  set <preset>        apply a preset — requires root
  toggle              toggle silent mode on/off (session-only, no root needed)
  edit                open $CONF in \$EDITOR — requires root
  presets             list available presets
EOF
}

need_root() { [[ $EUID -eq 0 ]] || { echo "error: requires root"; exit 1; }; }

find_hwmon() {
    grep -rl "^hp$" /sys/class/hwmon/*/name 2>/dev/null | head -1 | xargs dirname
}

HP_HWMON=$(find_hwmon)
CPU_TEMP=$(ls /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input 2>/dev/null | head -1)

cmd_status() {
    local preset="custom"
    [[ -f "$CONF" ]] && grep -q "^# preset:" "$CONF" && preset=$(grep "^# preset:" "$CONF" | cut -d' ' -f3)
    [[ -f "$SILENT_FLAG" ]] && preset="silent (session)"

    local cpu_mc fan1 fan2 pwm mode
    cpu_mc=$(< "$CPU_TEMP" 2>/dev/null) || cpu_mc=0
    fan1=$(< "$HP_HWMON/fan1_input" 2>/dev/null) || fan1=0
    fan2=$(< "$HP_HWMON/fan2_input" 2>/dev/null) || fan2=0
    pwm=$(< "$HP_HWMON/pwm1" 2>/dev/null) || pwm=0
    mode=$(< "$HP_HWMON/pwm1_enable" 2>/dev/null) || mode=0
    [[ $mode -eq 1 ]] && mode="manual (daemon active)" || mode="auto"

    printf "preset:  %s\n" "$preset"
    printf "mode:    %s\n" "$mode"
    echo   "---"
    printf "cpu:     %d°C\n"   "$(( cpu_mc / 1000 ))"
    printf "fan1:    %d rpm\n" "$fan1"
    printf "fan2:    %d rpm\n" "$fan2"
    printf "pwm:     %d/255\n" "$pwm"
}

write_preset() {
    local name=$1; shift
    cat > "$CONF" <<EOF
# preset: $name
CT=($*)
EOF
    shift ${#CT[@]}
    cat >> "$CONF" <<EOF
CP=($*)
EOF
}

cmd_set() {
    need_root
    local name=$1
    local ct cp hyst

    case "$name" in
        silent)
            ct="50000 60000 70000 82000 90000"
            cp="0     20    60    150   220"
            hyst=8000 ;;
        balanced)
            ct="40000 50000 60000 72000 82000"
            cp="0     30    80    170   240"
            hyst=6000 ;;
        performance)
            ct="35000 45000 58000 68000 78000"
            cp="30    80    140   210   255"
            hyst=4000 ;;
        *)
            echo "unknown preset: $name"
            echo "run 'hp-fan-curve presets' to list options"
            exit 1 ;;
    esac

    cat > "$CONF" <<EOF
# preset: $name
CT=($ct)
CP=($cp)
HYST_MC=$hyst
POLL_SEC=2
EOF
    systemctl restart hp-fan-control 2>/dev/null && echo "applied: $name" || echo "applied: $name (systemd not available — restart daemon manually)"
}

cmd_toggle() {
    if [[ -f "$SILENT_FLAG" ]]; then
        rm "$SILENT_FLAG"
        notify-send "fan" "normal" 2>/dev/null; echo "fan: normal"
    else
        touch "$SILENT_FLAG"
        notify-send "fan" "silent" 2>/dev/null; echo "fan: silent"
    fi
}

cmd_edit() {
    need_root
    [[ ! -f "$CONF" ]] && cmd_set balanced >/dev/null
    ${EDITOR:-nano} "$CONF"
    systemctl restart hp-fan-control 2>/dev/null
}

cmd_presets() {
    cat <<EOF
silent       fan stop to 50°C, slow ramp      — idle, library
balanced     fan stop to 40°C, default ramp   — daily use
performance  fans on from 35°C, max at 78°C   — gaming, compiling
EOF
}

case "$1" in
    status)   cmd_status ;;
    set)      cmd_set "$2" ;;
    toggle)   cmd_toggle ;;
    edit)     cmd_edit ;;
    presets)  cmd_presets ;;
    *)        usage ;;
esac
