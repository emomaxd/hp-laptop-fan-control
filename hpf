#!/bin/bash
set -euo pipefail

CONF=/etc/hpfand.conf
SILENT_FLAG=/var/lib/hpfand/silent
SYSFS_ROOT=${SYSFS_ROOT:-/sys}
SYSTEMCTL=${SYSTEMCTL:-systemctl}
HPFAND_BIN=${HPFAND_BIN:-hpfand}

usage() {
    cat <<EOF
usage: hpf <command>

commands:
  status [-w [N]]     live cpu/gpu temp, fan rpm, pwm, active preset
                      -w: watch mode, refresh every N seconds (default 2)
  set <preset>        apply a preset — requires root
  follow              auto-track platform power profile — requires root
  pwm <0-255>         lock fans at a fixed pwm value — requires root
  toggle              toggle silent mode on/off (persists across reboots)
  log [N]             show last N journal entries (default 50)
  edit                open $CONF in \$EDITOR — requires root
  presets             list available presets
EOF
}

need_root() { [[ $EUID -eq 0 ]] || { echo "error: requires root"; exit 1; }; }

find_hwmon() {
    local f dir
    for f in "$SYSFS_ROOT"/class/hwmon/*/name; do
        [[ -f "$f" && "$(<"$f")" == hp ]] || continue
        dir=$(dirname "$f")
        [[ -e "$dir/pwm1" && -e "$dir/pwm1_enable" ]] && echo "$dir" && return
    done
}

find_gpu_temps() {
    local f temp_file name dir
    for f in "$SYSFS_ROOT"/class/hwmon/*/name; do
        [[ -f "$f" ]] || continue
        name=$(<"$f")
        dir=$(dirname "$f")
        case "$name" in
            nvidia|amdgpu|radeon)
                for temp_file in "$dir"/temp*_input; do
                    [[ -f "$temp_file" ]] && echo "$temp_file"
                done ;;
        esac
    done
}

find_cpu_temp() {
    local dir f lf
    for dir in "$SYSFS_ROOT"/devices/platform/coretemp.*/hwmon/hwmon*; do
        [[ -d "$dir" ]] || continue
        for lf in "$dir"/temp*_label; do
            [[ -f "$lf" ]] || continue
            [[ "$(<"$lf")" == "Package id 0" ]] && echo "${lf/_label/_input}" && return
        done
        [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return
    done
    local name
    for f in "$SYSFS_ROOT"/class/hwmon/*/name; do
        [[ -f "$f" ]] || continue
        name=$(<"$f")
        [[ "$name" == "k10temp" || "$name" == "zenpower" ]] || continue
        dir=$(dirname "$f")
        for lf in "$dir"/temp*_label; do
            [[ -f "$lf" ]] || continue
            [[ "$(<"$lf")" == "Tdie" ]] && echo "${lf/_label/_input}" && return
        done
        [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return
    done
}

read_max_temp() {
    local path value max=0
    for path in "$@"; do
        value=$(cat "$path" 2>/dev/null) || continue
        [[ "$value" =~ ^[0-9]+$ ]] || continue
        (( value > 0 && value <= 150000 && value > max )) && max=$value
    done
    echo "$max"
}

find_fan_inputs() {
    local hwmon=$1 f
    for f in "$hwmon"/fan*_input; do
        [[ -f "$f" ]] && echo "$f"
    done
}

write_config() {
    local tmp
    tmp=$(mktemp "${CONF}.tmp.XXXXXX") || return 1
    if ! cat > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    if chown root:root "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$CONF"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

restore_firmware() {
    local hwmon=$1 mode
    if ! echo 2 > "$hwmon/pwm1_enable" 2>/dev/null \
        || ! mode=$(cat "$hwmon/pwm1_enable" 2>/dev/null) \
        || [[ "$mode" != "2" ]]; then
        echo "error: failed to restore firmware control" >&2
        return 1
    fi
}

print_status() {
    local HP_HWMON CPU_TEMP gpu_mc fan_path fan_rpm fan_name
    local -a GPU_TEMP_PATHS FAN_INPUT_PATHS
    HP_HWMON=$(find_hwmon)
    CPU_TEMP=$(find_cpu_temp)
    mapfile -t GPU_TEMP_PATHS < <(find_gpu_temps)
    [[ -d "$HP_HWMON" ]] || { echo "error: supported hp-wmi PWM interface not found" >&2; return 1; }
    mapfile -t FAN_INPUT_PATHS < <(find_fan_inputs "$HP_HWMON")

    local preset="custom"
    [[ -f "$CONF" ]] && grep -q "^# preset:" "$CONF" && preset=$(grep "^# preset:" "$CONF" | cut -d' ' -f3)
    [[ -f "$CONF" ]] && grep -q "^FOLLOW_PLATFORM_PROFILE=1" "$CONF" && preset="auto (follow profile)"
    [[ -f "$SILENT_FLAG" ]] && preset+=" [silent]"

    local cpu_mc pwm mode
    cpu_mc=$(cat "$CPU_TEMP" 2>/dev/null); cpu_mc=${cpu_mc:-0}
    pwm=$(cat "$HP_HWMON/pwm1" 2>/dev/null); pwm=${pwm:-0}
    mode=$(cat "$HP_HWMON/pwm1_enable" 2>/dev/null); mode=${mode:-0}
    [[ $mode -eq 1 ]] && mode="manual (daemon active)" || mode="auto"

    printf "preset:  %s\n" "$preset"
    printf "mode:    %s\n" "$mode"

    if [[ -f "$SYSFS_ROOT/firmware/acpi/platform_profile" ]]; then
        printf "profile: %s\n" "$(<"$SYSFS_ROOT/firmware/acpi/platform_profile")"
    fi

    echo   "---"
    printf "cpu:     %d°C\n" "$(( cpu_mc / 1000 ))"

    gpu_mc=$(read_max_temp "${GPU_TEMP_PATHS[@]}")
    if (( gpu_mc > 0 )); then
        printf "gpu:     %d°C\n" "$(( gpu_mc / 1000 ))"
    fi

    for fan_path in "${FAN_INPUT_PATHS[@]}"; do
        fan_rpm=$(cat "$fan_path" 2>/dev/null); fan_rpm=${fan_rpm:-0}
        fan_name=$(basename "$fan_path" _input)
        printf "%-8s %d rpm\n" "$fan_name:" "$fan_rpm"
    done
    printf "pwm:     %d/255\n" "$pwm"
}

cmd_status() {
    local watch=0 interval=2
    if [[ "${1:-}" == "-w" ]]; then
        watch=1
        [[ "${2:-}" =~ ^[0-9]+$ ]] && (( $2 > 0 )) && interval=$2
    fi

    if (( watch )); then
        while true; do
            clear
            print_status
            sleep "$interval"
        done
    else
        print_status
    fi
}

cmd_set() {
    need_root
    local name=${1:-}
    [[ -z "$name" ]] && { echo "usage: hpf set <preset>"; echo "run 'hpf presets' to list options"; exit 1; }
    local ct cp hyst poll

    case "$name" in
        silent)
            ct="50 60 70 82 90"; cp="0 20 60 150 255"; hyst=8; poll=4 ;;
        balanced)
            ct="40 50 60 72 82"; cp="0 30 80 170 255"; hyst=6; poll=2 ;;
        performance)
            ct="35 45 58 68 78"; cp="30 80 140 210 255"; hyst=4; poll=1 ;;
        *)
            echo "unknown preset: $name"
            echo "run 'hpf presets' to list options"
            exit 1 ;;
    esac

    cat > "$CONF" <<EOF
# preset: $name
CT=($ct)
CP=($cp)
HYST=$hyst
POLL_SEC=$poll
FOLLOW_PLATFORM_PROFILE=0
EOF
    systemctl restart hpfand 2>/dev/null \
        && echo "applied: $name" \
        || echo "applied: $name (restart daemon manually)"
}

cmd_follow() {
    need_root
    if [[ ! -f /sys/firmware/acpi/platform_profile ]]; then
        echo "error: /sys/firmware/acpi/platform_profile not found — power-profiles-daemon or similar required"
        exit 1
    fi
    cat > "$CONF" <<EOF
# preset: auto
FOLLOW_PLATFORM_PROFILE=1
EOF
    systemctl restart hpfand 2>/dev/null \
        && echo "follow: tracking platform profile ($(</sys/firmware/acpi/platform_profile))" \
        || echo "follow: enabled (restart daemon manually)"
}

cmd_toggle() {
    if [[ ! -w "$(dirname "$SILENT_FLAG")" ]]; then
        echo "error: silent mode requires membership in the hpfand group"
        echo "run: sudo usermod -aG hpfand $(id -un)  (then log in again)"
        exit 1
    fi
    if [[ -f "$SILENT_FLAG" ]]; then
        rm -f "$SILENT_FLAG"
        notify-send "fan" "normal" 2>/dev/null; echo "fan: normal"
    else
        touch "$SILENT_FLAG" 2>/dev/null || { echo "error: cannot write $SILENT_FLAG"; exit 1; }
        notify-send "fan" "silent" 2>/dev/null; echo "fan: silent"
    fi
}

cmd_log() {
    local lines=${1:-50}
    journalctl -u hpfand -n "$lines" --no-pager -o short
}

cmd_edit() {
    need_root
    [[ ! -f "$CONF" ]] && cmd_set balanced >/dev/null
    ${EDITOR:-nano} "$CONF"
    systemctl restart hpfand || echo "warning: failed to restart daemon — do it manually"
}

cmd_presets() {
    cat <<EOF
silent       min speed to 50°C, max at 90°C  — idle, library    (poll 4s)
balanced     min speed to 40°C, max at 82°C  — daily use         (poll 2s)
performance  fans on at 35°C, max at 78°C    — gaming, compiling  (poll 1s)
EOF
}

cmd_pwm() {
    need_root
    local val=$1
    [[ -z "$val" ]] && { echo "usage: hpf pwm <0-255>"; exit 1; }
    [[ "$val" =~ ^[0-9]+$ ]] && (( val <= 255 )) || { echo "error: value must be 0-255"; exit 1; }

    local HP_HWMON
    HP_HWMON=$(find_hwmon)
    [[ -d "$HP_HWMON" ]] || { echo "error: hp hwmon not found"; exit 1; }

    systemctl stop hpfand 2>/dev/null
    echo 1      > "$HP_HWMON/pwm1_enable"
    echo "$val" > "$HP_HWMON/pwm1"
    echo "pwm locked: $val/255 (daemon stopped)"
    echo "warning: no thermal protection — run 'hpf set <preset>' to restore"
}

case "$1" in
    status)   cmd_status "$2" "$3" ;;
    set)      cmd_set "$2" ;;
    follow)   cmd_follow ;;
    pwm)      cmd_pwm "$2" ;;
    toggle)   cmd_toggle ;;
    log)      cmd_log "$2" ;;
    edit)     cmd_edit ;;
    presets)  cmd_presets ;;
    *)        usage ;;
esac
