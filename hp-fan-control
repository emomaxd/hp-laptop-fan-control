#!/bin/bash

CONF=/etc/hp-fan-control.conf
SILENT_FLAG=/tmp/hp-fan-silent

CT=(40 50 60 72 82)
CP=(0  30 80 170 240)
HYST=6
POLL_SEC=2

[[ -f "$CONF" ]] && source "$CONF"

for i in "${!CT[@]}"; do CT[$i]=$(( CT[i] * 1000 )); done
HYST_MC=$(( HYST * 1000 ))

find_hwmon() {
    grep -rl "^hp$" /sys/class/hwmon/*/name 2>/dev/null | head -1 | xargs dirname
}

HP_HWMON=$(find_hwmon)
CPU_TEMP=$(ls /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input 2>/dev/null | head -1)

[[ -d "$HP_HWMON" ]] || { echo "hp-wmi hwmon not found" >&2; exit 1; }
[[ -f "$CPU_TEMP" ]] || { echo "coretemp not found"     >&2; exit 1; }

lerp() { echo $(( $2 + ($5 - $1) * ($4 - $2) / ($3 - $1) )); }

pwm_for_temp() {
    local t=$1 n=${#CT[@]}
    (( t <= CT[0] ))   && echo 0   && return
    (( t >= CT[n-1] )) && echo 255 && return
    local i
    for (( i=0; i < n-1; i++ )); do
        (( t >= CT[i] && t < CT[i+1] )) && lerp "${CT[i]}" "${CP[i]}" "${CT[i+1]}" "${CP[i+1]}" "$t" && return
    done
    echo 255
}

apply() {
    echo 1    > "$HP_HWMON/pwm1_enable"
    echo "$1" > "$HP_HWMON/pwm1"
}

cleanup() { echo 2 > "$HP_HWMON/pwm1_enable"; exit; }
trap cleanup SIGTERM SIGINT

cur_pwm=255; apply $cur_pwm
last_up_temp=999999

while true; do
    sleep $POLL_SEC

    if [[ -f "$SILENT_FLAG" ]]; then
        (( cur_pwm != 0 )) && { apply 0; cur_pwm=0; }
        continue
    fi

    temp=$(< "$CPU_TEMP")
    target=$(pwm_for_temp "$temp")

    if (( target > cur_pwm )); then
        apply $target; cur_pwm=$target; last_up_temp=$temp
    elif (( target < cur_pwm && temp <= last_up_temp - HYST_MC )); then
        apply $target; cur_pwm=$target; last_up_temp=$temp
    fi
done
