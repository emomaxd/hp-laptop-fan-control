#!/bin/bash

CONF=/etc/hpfand.conf
SILENT_FLAG=/var/lib/hpfand/silent
DRY_RUN=0
MAINPID=$$
INOTIFY_PID=

[[ "$1" == "--dry-run" ]] && DRY_RUN=1

CT=() CP=() GPU_CT=() GPU_CP=()
HYST=6; POLL_SEC=2; HYST_MC=6000
FOLLOW_PLATFORM_PROFILE=0; RPM_STALL_WARN=1

load_conf() {
    CT=(40 50 60 72 82)
    CP=(0  30 80 170 240)
    GPU_CT=()
    GPU_CP=()
    HYST=6
    POLL_SEC=2
    FOLLOW_PLATFORM_PROFILE=0
    RPM_STALL_WARN=1

    if [[ -f "$CONF" ]]; then
        source "$CONF" || echo "warning: failed to source $CONF, using defaults" >&2
    fi

    for i in "${!CT[@]}"; do CT[$i]=$(( CT[i] * 1000 )); done
    HYST_MC=$(( HYST * 1000 ))
    (( POLL_SEC > 0 )) || POLL_SEC=2

    if (( ${#GPU_CT[@]} == 0 )); then
        GPU_CT=("${CT[@]}")
        GPU_CP=("${CP[@]}")
    else
        for i in "${!GPU_CT[@]}"; do GPU_CT[$i]=$(( GPU_CT[i] * 1000 )); done
    fi
}

find_hwmon() {
    grep -rl "^hp$" /sys/class/hwmon/*/name 2>/dev/null | head -1 | xargs -r dirname
}

find_gpu_temp() {
    local f name dir
    for f in /sys/class/hwmon/*/name; do
        [[ -f "$f" ]] || continue
        name=$(<"$f")
        dir=$(dirname "$f")
        case "$name" in
            nvidia|amdgpu|radeon)
                [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return ;;
        esac
    done
}

HP_HWMON=$(find_hwmon)
CPU_TEMP=$(ls /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input 2>/dev/null | head -1)
GPU_TEMP=$(find_gpu_temp)

[[ -d "$HP_HWMON" ]] || { echo "hp-wmi hwmon not found" >&2; exit 1; }
[[ -f "$CPU_TEMP" ]] || { echo "coretemp not found"     >&2; exit 1; }

load_conf

lerp() {
    local dt=$(( $3 - $1 ))
    (( dt == 0 )) && echo "$2" && return
    echo $(( $2 + ($5 - $1) * ($4 - $2) / dt ))
}

pwm_for_temp() {
    local -n _ct=$1 _cp=$2
    local t=$3 n=${#_ct[@]}
    (( t <= _ct[0] ))   && echo 0   && return
    (( t >= _ct[n-1] )) && echo 255 && return
    local i
    for (( i=0; i < n-1; i++ )); do
        (( t >= _ct[i] && t < _ct[i+1] )) && lerp "${_ct[i]}" "${_cp[i]}" "${_ct[i+1]}" "${_cp[i+1]}" "$t" && return
    done
    echo 255
}

profile_to_curves() {
    case "$1" in
        low-power)
            CT=(50000 60000 70000 82000 90000)
            CP=(0 20 60 150 220)
            HYST_MC=8000; POLL_SEC=4 ;;
        balanced)
            CT=(40000 50000 60000 72000 82000)
            CP=(0 30 80 170 240)
            HYST_MC=6000; POLL_SEC=2 ;;
        performance)
            CT=(35000 45000 58000 68000 78000)
            CP=(30 80 140 210 255)
            HYST_MC=4000; POLL_SEC=1 ;;
    esac
    GPU_CT=("${CT[@]}")
    GPU_CP=("${CP[@]}")
}

apply() {
    if (( DRY_RUN )); then
        echo "dry-run: pwm=$1 (cpu=${2}mc gpu=${3}mc)" >&2
        return 0
    fi
    local i
    for ((i=0; i<5; i++)); do
        echo 1 > "$HP_HWMON/pwm1_enable" 2>/dev/null
        if [[ "$(<"$HP_HWMON/pwm1_enable")" == "1" ]]; then
            echo "$1" > "$HP_HWMON/pwm1"
            return 0
        fi
    done
    echo "warning: failed to set pwm1_enable after 5 attempts" >&2
    return 1
}

start_inotify() {
    command -v inotifywait &>/dev/null || return
    [[ -f "$CONF" ]] || return
    ( inotifywait -q -m -e close_write "$CONF" 2>/dev/null | while read -r _; do
          kill -USR1 "$MAINPID" 2>/dev/null
      done ) &
    INOTIFY_PID=$!
}

on_reload() {
    echo "info: reloading conf" >&2
    load_conf
    last_up_temp=999999
    last_profile=""
}

cleanup() {
    [[ -n "$INOTIFY_PID" ]] && kill "$INOTIFY_PID" 2>/dev/null
    if (( ! DRY_RUN )); then
        [[ -d "$HP_HWMON" ]] && echo 2 > "$HP_HWMON/pwm1_enable"
    fi
    exit
}

trap on_reload USR1
trap cleanup SIGTERM SIGINT

start_inotify

# Cold start: set correct PWM immediately without waiting one poll cycle
cpu_temp_init=$(<"$CPU_TEMP" 2>/dev/null)
if [[ -n "$cpu_temp_init" ]]; then
    cur_pwm=$(pwm_for_temp CT CP "$cpu_temp_init")
    last_up_temp=$cpu_temp_init
else
    cur_pwm=255
    last_up_temp=999999
fi
apply "$cur_pwm" "${cpu_temp_init:-0}" "0"

last_profile=""
stall_cycles=0

while true; do
    sleep "$POLL_SEC" & wait $!

    if (( FOLLOW_PLATFORM_PROFILE )) && [[ -f /sys/firmware/acpi/platform_profile ]]; then
        prof=$(<"/sys/firmware/acpi/platform_profile")
        if [[ "$prof" != "$last_profile" ]]; then
            profile_to_curves "$prof"
            last_profile=$prof
            last_up_temp=999999
            echo "info: platform profile -> '$prof', updated fan curve" >&2
        fi
    fi

    cpu_temp=$(<"$CPU_TEMP")
    [[ -z "$cpu_temp" ]] && continue

    [[ -z "$GPU_TEMP" || ! -f "$GPU_TEMP" ]] && GPU_TEMP=$(find_gpu_temp)
    gpu_temp=0
    [[ -n "$GPU_TEMP" ]] && gpu_temp=$(<"$GPU_TEMP")

    cpu_target=$(pwm_for_temp CT CP "$cpu_temp")
    gpu_target=0
    (( gpu_temp > 0 )) && gpu_target=$(pwm_for_temp GPU_CT GPU_CP "$gpu_temp")
    target=$(( cpu_target > gpu_target ? cpu_target : gpu_target ))

    if [[ -f "$SILENT_FLAG" ]]; then
        local_cpu_below=$(( cpu_temp < CT[${#CT[@]}-1] ))
        local_gpu_below=$(( gpu_temp == 0 || gpu_temp < GPU_CT[${#GPU_CT[@]}-1] ))
        (( local_cpu_below && local_gpu_below )) && target=0
    fi

    effective_temp=$(( cpu_temp > gpu_temp ? cpu_temp : gpu_temp ))

    if (( target > cur_pwm )); then
        cur_pwm=$target
        last_up_temp=$effective_temp
    elif (( target < cur_pwm && effective_temp <= last_up_temp - HYST_MC )); then
        cur_pwm=$target
        last_up_temp=$effective_temp
    fi

    if apply "$cur_pwm" "$cpu_temp" "$gpu_temp"; then
        if (( RPM_STALL_WARN && cur_pwm > 80 )); then
            (( stall_cycles++ ))
            if (( stall_cycles >= 5 )); then
                fan1=$(cat "$HP_HWMON/fan1_input" 2>/dev/null)
                if [[ -n "$fan1" ]] && (( fan1 < 200 )); then
                    echo "warning: fan may be stalled — pwm=$cur_pwm but fan1=${fan1}rpm" >&2
                fi
                stall_cycles=0
            fi
        else
            stall_cycles=0
        fi
    fi
done
