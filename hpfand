#!/bin/bash

CONF=${CONF:-/etc/hpfand.conf}
SILENT_FLAG=${SILENT_FLAG:-/var/lib/hpfand/silent}
DRY_RUN=0
MAINPID=$$
INOTIFY_PID=

[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

CT=() CP=() GPU_CT=() GPU_CP=()
HYST=6; POLL_SEC=2; HYST_MC=6000
FOLLOW_PLATFORM_PROFILE=0; RPM_STALL_WARN=1
SLEW_UP=100; SLEW_DOWN=20; MIN_PWM=0
SILENT_OFF_BELOW=0; SILENT_OFF_BELOW_MC=0; GPU_SILENT_OFF_BELOW_MC=0

set_defaults() {
    CT=(40 50 60 72 82); CP=(0 30 80 170 255)
    GPU_CT=(); GPU_CP=()
    HYST=6; POLL_SEC=2
    FOLLOW_PLATFORM_PROFILE=0; RPM_STALL_WARN=1
    SLEW_UP=100; SLEW_DOWN=20; MIN_PWM=0; SILENT_OFF_BELOW=0
}

conf_safe() {
    local uid mode
    read -r uid mode < <(stat -Lc '%u %a' "$CONF" 2>/dev/null) || return 1
    [[ "$uid" == "0" ]] || { echo "warning: $CONF not owned by root — skipping" >&2; return 1; }
    (( (8#$mode & 8#022) == 0 )) || { echo "warning: $CONF is group/world-writable — skipping" >&2; return 1; }
}

lerp() {
    local dt=$(( $3 - $1 ))
    (( dt == 0 )) && echo "$2" && return
    echo $(( $2 + ($5 - $1) * ($4 - $2) / dt ))
}

pwm_for_temp() {
    local -n _ct=$1 _cp=$2
    local t=$3 n=${#_ct[@]}
    (( t <= _ct[0] ))   && echo "${_cp[0]}"   && return
    (( t >= _ct[n-1] )) && echo "${_cp[n-1]}" && return
    local i
    for (( i=0; i < n-1; i++ )); do
        (( t >= _ct[i] && t < _ct[i+1] )) && lerp "${_ct[i]}" "${_cp[i]}" "${_ct[i+1]}" "${_cp[i+1]}" "$t" && return
    done
    echo 255
}

validate_curve() {
    local label=$1
    local -n _ct=$2 _cp=$3
    local n=${#_ct[@]} i
    (( n >= 2 && ${#_cp[@]} == n )) || return 1
    for (( i=0; i < n-1; i++ )); do
        if (( _ct[i] >= _ct[i+1] )); then
            echo "warning: $label CT not strictly increasing at index $i — using defaults" >&2
            return 1
        fi
        if (( _cp[i] > _cp[i+1] )); then
            echo "warning: $label CP not non-decreasing at index $i — using defaults" >&2
            return 1
        fi
    done
    for (( i=0; i < n; i++ )); do
        [[ "${_ct[i]}" =~ ^[0-9]+$ && "${_cp[i]}" =~ ^-?[0-9]+$ ]] || return 1
        (( _ct[i] <= 150 )) || return 1
        if (( _cp[i] < 0 || _cp[i] > 255 )); then
            echo "warning: $label CP[$i]=${_cp[i]} out of range [0,255] — using defaults" >&2
            return 1
        fi
    done
}

parse_conf() {
    local line key value item normalized
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%%#*}
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        if [[ "$line" =~ ^(CT|CP|GPU_CT|GPU_CP)=\(([^()]*)\)$ ]]; then
            key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
            read -r -a parsed <<< "$value"
            normalized=()
            for item in "${parsed[@]}"; do
                [[ "$item" =~ ^-?[0-9]+$ ]] || return 1
                if [[ "$item" == -* ]]; then normalized+=("-$(( 10#${item#-} ))")
                else normalized+=("$(( 10#$item ))")
                fi
            done
            case "$key" in
                CT) CT=("${normalized[@]}") ;; CP) CP=("${normalized[@]}") ;;
                GPU_CT) GPU_CT=("${normalized[@]}") ;; GPU_CP) GPU_CP=("${normalized[@]}") ;;
            esac
        elif [[ "$line" =~ ^(HYST|POLL_SEC|FOLLOW_PLATFORM_PROFILE|RPM_STALL_WARN|SLEW_UP|SLEW_DOWN|MIN_PWM|SILENT_OFF_BELOW)=(-?[0-9]+)$ ]]; then
            key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
            if [[ "$value" == -* ]]; then value="-$(( 10#${value#-} ))"; else value=$(( 10#$value )); fi
            printf -v "$key" '%s' "$value"
        else
            echo "warning: invalid or unsupported config line: $line" >&2
            return 1
        fi
    done < "$CONF"
}

load_conf() {
    set_defaults

    if [[ -f "$CONF" ]]; then
        if conf_safe; then
            if ! parse_conf; then
                echo "warning: failed to parse $CONF, using defaults" >&2
                set_defaults
            fi
        fi
    fi

    if (( ${#CT[@]} < 2 || ${#CP[@]} != ${#CT[@]} )); then
        echo "warning: CT/CP array mismatch in $CONF, using defaults" >&2
        CT=(40 50 60 72 82)
        CP=(0  30 80 170 255)
    fi
    validate_curve CPU CT CP || { CT=(40 50 60 72 82); CP=(0 30 80 170 255); }

    (( HYST >= 0 && HYST <= 30 )) || HYST=6
    (( POLL_SEC >= 1 && POLL_SEC <= 60 )) || POLL_SEC=2
    (( FOLLOW_PLATFORM_PROFILE == 0 || FOLLOW_PLATFORM_PROFILE == 1 )) || FOLLOW_PLATFORM_PROFILE=0
    (( RPM_STALL_WARN == 0 || RPM_STALL_WARN == 1 )) || RPM_STALL_WARN=1
    (( SLEW_UP >= 1 && SLEW_UP <= 255 )) || SLEW_UP=100
    (( SLEW_DOWN >= 1 && SLEW_DOWN <= 255 )) || SLEW_DOWN=20
    (( SILENT_OFF_BELOW >= 0 && SILENT_OFF_BELOW <= 120 )) || SILENT_OFF_BELOW=0

    for i in "${!CT[@]}"; do CT[$i]=$(( CT[i] * 1000 )); done
    HYST_MC=$(( HYST * 1000 ))
    (( MIN_PWM >= 0 && MIN_PWM <= 255 )) || MIN_PWM=0
    if (( SILENT_OFF_BELOW > 0 )); then
        SILENT_OFF_BELOW_MC=$(( SILENT_OFF_BELOW * 1000 ))
    else
        SILENT_OFF_BELOW_MC=${CT[${#CT[@]}-2]}
    fi

    if (( ${#GPU_CT[@]} == 0 )); then
        GPU_CT=("${CT[@]}")
        GPU_CP=("${CP[@]}")
    else
        if (( ${#GPU_CP[@]} != ${#GPU_CT[@]} )); then
            echo "warning: GPU_CT/GPU_CP array mismatch in $CONF, ignoring GPU overrides" >&2
            GPU_CT=("${CT[@]}")
            GPU_CP=("${CP[@]}")
        else
            if validate_curve GPU GPU_CT GPU_CP; then
                for i in "${!GPU_CT[@]}"; do GPU_CT[$i]=$(( GPU_CT[i] * 1000 )); done
            else
                GPU_CT=("${CT[@]}")
                GPU_CP=("${CP[@]}")
            fi
        fi
    fi
    if (( SILENT_OFF_BELOW > 0 )); then
        GPU_SILENT_OFF_BELOW_MC=$SILENT_OFF_BELOW_MC
    else
        GPU_SILENT_OFF_BELOW_MC=${GPU_CT[${#GPU_CT[@]}-2]}
    fi
}

find_hwmon() {
    local f dir
    for f in /sys/class/hwmon/*/name; do
        [[ -f "$f" && "$(<"$f")" == hp ]] || continue
        dir=$(dirname "$f")
        [[ -e "$dir/pwm1" && -e "$dir/pwm1_enable" ]] && echo "$dir" && return
    done
}

find_gpu_temp() {
    local f name dir
    for f in /sys/class/hwmon/*/name; do
        [[ -f "$f" ]] || continue
        name=$(<"$f")
        dir=$(dirname "$f")
        case "$name" in
            nvidia|amdgpu|radeon)
                [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return ;;
        esac
    done
}

find_cpu_temp() {
    local dir f lf
    # Intel coretemp: prefer "Package id 0" label over temp1 which may be a single core
    for dir in /sys/devices/platform/coretemp.*/hwmon/hwmon*; do
        [[ -d "$dir" ]] || continue
        for lf in "$dir"/temp*_label; do
            [[ -f "$lf" ]] || continue
            [[ "$(<"$lf")" == "Package id 0" ]] && echo "${lf/_label/_input}" && return
        done
        [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return
    done
    # AMD k10temp / zenpower: prefer Tdie (no offset) over Tctl which has +10°C on some Zen
    local name
    for f in /sys/class/hwmon/*/name; do
        [[ -f "$f" ]] || continue
        name=$(<"$f")
        [[ "$name" == "k10temp" || "$name" == "zenpower" ]] || continue
        dir=$(dirname "$f")
        for lf in "$dir"/temp*_label; do
            [[ -f "$lf" ]] || continue
            [[ "$(<"$lf")" == "Tdie" ]] && echo "${lf/_label/_input}" && return
        done
        [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return
    done
}

profile_to_curves() {
    case "$1" in
        low-power)
            CT=(50000 60000 70000 82000 90000)
            CP=(0 20 60 150 255)
            HYST_MC=8000; POLL_SEC=4 ;;
        balanced)
            CT=(40000 50000 60000 72000 82000)
            CP=(0 30 80 170 255)
            HYST_MC=6000; POLL_SEC=2 ;;
        performance)
            CT=(35000 45000 58000 68000 78000)
            CP=(30 80 140 210 255)
            HYST_MC=4000; POLL_SEC=1 ;;
        *) return ;;
    esac
    GPU_CT=("${CT[@]}")
    GPU_CP=("${CP[@]}")
    if (( SILENT_OFF_BELOW > 0 )); then
        SILENT_OFF_BELOW_MC=$(( SILENT_OFF_BELOW * 1000 ))
        GPU_SILENT_OFF_BELOW_MC=$SILENT_OFF_BELOW_MC
    else
        SILENT_OFF_BELOW_MC=${CT[${#CT[@]}-2]}
        GPU_SILENT_OFF_BELOW_MC=${GPU_CT[${#GPU_CT[@]}-2]}
    fi
}

apply() {
    if (( DRY_RUN )); then
        echo "dry-run: pwm=$1 (cpu=${2}mc gpu=${3}mc)" >&2
        return 0
    fi
    if ! echo "$1" > "$HP_HWMON/pwm1" 2>/dev/null; then
        echo "error: failed to write pwm=$1" >&2
        return 1
    fi
}

start_inotify() {
    command -v inotifywait &>/dev/null || return
    [[ -f "$CONF" ]] || return
    ( inotifywait -q -m -e close_write,moved_to,create --format '%f' "$(dirname "$CONF")" 2>/dev/null | while read -r file; do
          [[ "$file" == "$(basename "$CONF")" ]] || continue
          kill -USR1 "$MAINPID" 2>/dev/null
      done ) &
    INOTIFY_PID=$!
}

on_reload() {
    echo "info: reloading conf" >&2
    load_conf
    last_up_temp=999999
    last_profile=""
    desired_pwm=$cur_pwm
}

cleanup() {
    [[ -n "$INOTIFY_PID" ]] && kill "$INOTIFY_PID" 2>/dev/null
    if (( ! DRY_RUN )); then
        [[ -d "$HP_HWMON" ]] && echo 2 > "$HP_HWMON/pwm1_enable"
    fi
    exit
}

next_pwm() {
    local desired=$1 current=$2 starting=$3
    if (( desired > current + SLEW_UP )); then
        echo $(( current + SLEW_UP ))
    elif (( desired < current )); then
        if (( starting )); then echo "$current"
        elif (( desired < current - SLEW_DOWN )); then echo $(( current - SLEW_DOWN ))
        else echo "$desired"
        fi
    else
        echo "$desired"
    fi
}

main() {
HP_HWMON=$(find_hwmon)
CPU_TEMP=$(find_cpu_temp)
GPU_TEMP=$(find_gpu_temp)

[[ -d "$HP_HWMON" ]] || { echo "hp-wmi hwmon not found" >&2; exit 1; }
if (( ! DRY_RUN )); then
    [[ -w "$HP_HWMON/pwm1" && -w "$HP_HWMON/pwm1_enable" ]] || { echo "hp-wmi PWM interface missing or not writable" >&2; exit 1; }
fi
[[ -f "$CPU_TEMP" ]] || { echo "cpu temp sensor not found (tried coretemp, k10temp, zenpower)" >&2; exit 1; }

load_conf

trap on_reload USR1
trap cleanup SIGTERM SIGINT

start_inotify

# Start from wherever the hardware already is — avoids jarring takeover on boot
cpu_temp_init=$(cat "$CPU_TEMP" 2>/dev/null)
if [[ "$cpu_temp_init" =~ ^[0-9]+$ ]] && (( cpu_temp_init > 0 && cpu_temp_init <= 150000 )); then
    ema_cpu=$cpu_temp_init
else
    ema_cpu=0
fi
last_up_temp=999999
cur_pwm_hw=$(cat "$HP_HWMON/pwm1" 2>/dev/null)
[[ "$cur_pwm_hw" =~ ^[0-9]+$ ]] && cur_pwm=$cur_pwm_hw || cur_pwm=255
if (( ! DRY_RUN )) && ! echo 1 > "$HP_HWMON/pwm1_enable" 2>/dev/null; then
    echo "error: failed to enable manual fan control" >&2
    exit 1
fi
apply "$cur_pwm" "${cpu_temp_init:-0}" "0" || { cleanup; return 1; }
echo "info: started — cpu=$(( ${cpu_temp_init:-0} / 1000 ))°C pwm=$cur_pwm" >&2

last_profile=""
desired_pwm=$cur_pwm
prev_pwm=$cur_pwm
stall_cycles=0
sensor_miss=0
ema_gpu=0
gpu_miss=0
startup_cycles=15

while true; do
    sleep "$POLL_SEC" & wait $!

    if (( FOLLOW_PLATFORM_PROFILE )) && [[ -f /sys/firmware/acpi/platform_profile ]]; then
        prof=$(<"/sys/firmware/acpi/platform_profile")
        if [[ "$prof" != "$last_profile" ]]; then
            profile_to_curves "$prof"
            last_profile=$prof
            last_up_temp=999999
            echo "info: platform profile -> '$prof', updated fan curve" >&2
        fi
    fi

    cpu_temp=$(<"$CPU_TEMP")
    if [[ ! "$cpu_temp" =~ ^[0-9]+$ ]] || (( cpu_temp <= 0 || cpu_temp > 150000 )); then
        (( ++sensor_miss ))
        if (( sensor_miss >= 3 )); then
            if apply 255 0 0; then
                cur_pwm=255; prev_pwm=255; desired_pwm=255
                last_up_temp=999999
            fi
            (( sensor_miss == 3 )) && echo "warning: cpu temp unreadable — fan at full speed" >&2
        fi
        continue
    fi
    sensor_miss=0

    if (( startup_cycles > 0 )); then
        ema_cpu=$(( (8 * cpu_temp + 2 * ema_cpu) / 10 ))
    else
        ema_cpu=$(( (3 * cpu_temp + 7 * ema_cpu) / 10 ))
    fi

    [[ -z "$GPU_TEMP" || ! -f "$GPU_TEMP" ]] && GPU_TEMP=$(find_gpu_temp)
    gpu_temp=0
    [[ -n "$GPU_TEMP" ]] && gpu_temp=$(cat "$GPU_TEMP" 2>/dev/null)
    if [[ "$gpu_temp" =~ ^[0-9]+$ ]] && (( gpu_temp > 0 && gpu_temp <= 150000 )); then
        gpu_miss=0
        if (( startup_cycles > 0 )); then
            ema_gpu=$(( (8 * gpu_temp + 2 * ema_gpu) / 10 ))
        else
            ema_gpu=$(( (3 * gpu_temp + 7 * ema_gpu) / 10 ))
        fi
    elif (( ema_gpu > 0 && gpu_miss < 3 )); then
        (( gpu_miss++ ))
    else
        ema_gpu=0
        gpu_miss=0
    fi

    cpu_target=$(pwm_for_temp CT CP "$ema_cpu")
    gpu_target=0
    (( ema_gpu > 0 )) && gpu_target=$(pwm_for_temp GPU_CT GPU_CP "$ema_gpu")
    target=$(( cpu_target > gpu_target ? cpu_target : gpu_target ))

    if [[ -f "$SILENT_FLAG" ]]; then
        (( ema_cpu < SILENT_OFF_BELOW_MC && (ema_gpu == 0 || ema_gpu < GPU_SILENT_OFF_BELOW_MC) )) && target=0
    fi

    effective_temp=$(( ema_cpu > ema_gpu ? ema_cpu : ema_gpu ))

    if (( target > desired_pwm )); then
        desired_pwm=$target
        last_up_temp=$effective_temp
    elif (( target < desired_pwm && effective_temp <= last_up_temp - HYST_MC )); then
        desired_pwm=$target
    fi

    candidate_pwm=$(next_pwm "$desired_pwm" "$cur_pwm" "$(( startup_cycles > 0 ))")
    (( startup_cycles > 0 )) && (( startup_cycles-- ))

    (( MIN_PWM > 0 && candidate_pwm > 0 && candidate_pwm < MIN_PWM )) && candidate_pwm=$MIN_PWM

    if (( candidate_pwm != prev_pwm )); then
        if apply "$candidate_pwm" "$ema_cpu" "$ema_gpu"; then
            cur_pwm=$candidate_pwm
            prev_pwm=$candidate_pwm
        fi
    fi

    if (( RPM_STALL_WARN && cur_pwm > 80 )); then
        (( stall_cycles++ ))
        if (( stall_cycles >= 5 )); then
            fan1=$(cat "$HP_HWMON/fan1_input" 2>/dev/null)
            if [[ "$fan1" =~ ^[0-9]+$ ]] && (( fan1 < 200 )); then
                echo "warning: fan may be stalled — pwm=$cur_pwm but fan1=${fan1}rpm" >&2
            fi
            stall_cycles=0
        fi
    else
        stall_cycles=0
    fi
done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
