#!/bin/bash

CONF=${CONF:-/etc/hpfand.conf}
SILENT_FLAG=${SILENT_FLAG:-/var/lib/hpfand/silent}
SYSFS_ROOT=${SYSFS_ROOT:-/sys}
DRY_RUN=0
CHECK_CONF=0
MAINPID=$$
INOTIFY_PID=

case "${1:-}" in
    --dry-run) DRY_RUN=1 ;;
    --check-config) CHECK_CONF=1; CONF=${2:-$CONF} ;;
esac

CT=() CP=() GPU_CT=() GPU_CP=()
HYST=6; POLL_SEC=2; HYST_MC=6000
FOLLOW_PLATFORM_PROFILE=0; RPM_STALL_WARN=1
SLEW_UP=100; SLEW_DOWN=20; MIN_PWM=0
SILENT_OFF_BELOW=0; SILENT_OFF_BELOW_MC=0; GPU_SILENT_OFF_BELOW_MC=0
EMERGENCY_TEMP=95; EMERGENCY_TEMP_MC=95000
GPU_TEMPS=(); FAN_INPUTS=()
GPU_CURVE_CUSTOM=0; CONFIG_LOADED=0
LOOP_LIMIT=${HPFAND_TEST_LOOPS:-0}
SKIP_SLEEP=${HPFAND_TEST_NO_SLEEP:-0}
LOCK_FILE=${LOCK_FILE:-/run/hpfand/daemon.lock}
LOCK_FD=

set_defaults() {
    CT=(40 50 60 72 82); CP=(0 30 80 170 255)
    GPU_CT=(); GPU_CP=()
    HYST=6; POLL_SEC=2
    FOLLOW_PLATFORM_PROFILE=0; RPM_STALL_WARN=1
    SLEW_UP=100; SLEW_DOWN=20; MIN_PWM=0; SILENT_OFF_BELOW=0
    EMERGENCY_TEMP=95
}

conf_safe() {
    local uid mode
    read -r uid mode < <(stat -Lc '%u %a' "$CONF" 2>/dev/null) || return 1
    [[ "$uid" == "0" ]] || { echo "warning: $CONF not owned by root — skipping" >&2; return 1; }
    (( (8#$mode & 8#022) == 0 )) || { echo "warning: $CONF is group/world-writable — skipping" >&2; return 1; }
}

lerp() {
    local dt=$(( $3 - $1 ))
    (( dt == 0 )) && echo "$2" && return
    echo $(( $2 + ($5 - $1) * ($4 - $2) / dt ))
}

pwm_for_temp() {
    local -n _ct=$1 _cp=$2
    local t=$3 n=${#_ct[@]}
    (( t <= _ct[0] ))   && echo "${_cp[0]}"   && return
    (( t >= _ct[n-1] )) && echo "${_cp[n-1]}" && return
    local i
    for (( i=0; i < n-1; i++ )); do
        (( t >= _ct[i] && t < _ct[i+1] )) && lerp "${_ct[i]}" "${_cp[i]}" "${_ct[i+1]}" "${_cp[i+1]}" "$t" && return
    done
    echo 255
}

validate_curve() {
    local label=$1
    local -n _ct=$2 _cp=$3
    local n=${#_ct[@]} i
    (( n >= 2 && ${#_cp[@]} == n )) || return 1
    for (( i=0; i < n-1; i++ )); do
        if (( _ct[i] >= _ct[i+1] )); then
            echo "warning: $label CT not strictly increasing at index $i" >&2
            return 1
        fi
        if (( _cp[i] > _cp[i+1] )); then
            echo "warning: $label CP not non-decreasing at index $i" >&2
            return 1
        fi
    done
    for (( i=0; i < n; i++ )); do
        [[ "${_ct[i]}" =~ ^[0-9]+$ && "${_cp[i]}" =~ ^-?[0-9]+$ ]] || return 1
        (( _ct[i] <= 150 )) || return 1
        if (( _cp[i] < 0 || _cp[i] > 255 )); then
            echo "warning: $label CP[$i]=${_cp[i]} out of range [0,255]" >&2
            return 1
        fi
    done
}

parse_conf() {
    local line key value item normalized
    while IFS= read -r line || [[ -n "$line" ]]; do
        line=${line%%#*}
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        if [[ "$line" =~ ^(CT|CP|GPU_CT|GPU_CP)=\(([^()]*)\)$ ]]; then
            key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
            read -r -a parsed <<< "$value"
            normalized=()
            for item in "${parsed[@]}"; do
                [[ "$item" =~ ^-?[0-9]+$ ]] || return 1
                if [[ "$item" == -* ]]; then normalized+=("-$(( 10#${item#-} ))")
                else normalized+=("$(( 10#$item ))")
                fi
            done
            case "$key" in
                CT) CT=("${normalized[@]}") ;; CP) CP=("${normalized[@]}") ;;
                GPU_CT) GPU_CT=("${normalized[@]}") ;; GPU_CP) GPU_CP=("${normalized[@]}") ;;
            esac
        elif [[ "$line" =~ ^(HYST|POLL_SEC|FOLLOW_PLATFORM_PROFILE|RPM_STALL_WARN|SLEW_UP|SLEW_DOWN|MIN_PWM|SILENT_OFF_BELOW|EMERGENCY_TEMP)=(-?[0-9]+)$ ]]; then
            key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
            if [[ "$value" == -* ]]; then value="-$(( 10#${value#-} ))"; else value=$(( 10#$value )); fi
            printf -v "$key" '%s' "$value"
        else
            echo "warning: invalid or unsupported config line: $line" >&2
            return 1
        fi
    done < "$CONF"
}

normalize_conf() {
    if (( ${#CT[@]} < 2 || ${#CP[@]} != ${#CT[@]} )); then
        echo "warning: CT/CP array mismatch in $CONF" >&2
        return 1
    fi
    validate_curve CPU CT CP || return 1

    (( HYST >= 0 && HYST <= 30 )) || { echo "warning: HYST must be 0-30" >&2; return 1; }
    (( POLL_SEC >= 1 && POLL_SEC <= 60 )) || { echo "warning: POLL_SEC must be 1-60" >&2; return 1; }
    (( FOLLOW_PLATFORM_PROFILE == 0 || FOLLOW_PLATFORM_PROFILE == 1 )) || { echo "warning: FOLLOW_PLATFORM_PROFILE must be 0 or 1" >&2; return 1; }
    (( RPM_STALL_WARN == 0 || RPM_STALL_WARN == 1 )) || { echo "warning: RPM_STALL_WARN must be 0 or 1" >&2; return 1; }
    (( SLEW_UP >= 1 && SLEW_UP <= 255 )) || { echo "warning: SLEW_UP must be 1-255" >&2; return 1; }
    (( SLEW_DOWN >= 1 && SLEW_DOWN <= 255 )) || { echo "warning: SLEW_DOWN must be 1-255" >&2; return 1; }
    (( MIN_PWM >= 0 && MIN_PWM <= 255 )) || { echo "warning: MIN_PWM must be 0-255" >&2; return 1; }
    (( SILENT_OFF_BELOW >= 0 && SILENT_OFF_BELOW <= 100 )) || { echo "warning: SILENT_OFF_BELOW must be 0-100" >&2; return 1; }
    (( EMERGENCY_TEMP >= 70 && EMERGENCY_TEMP <= 100 )) || { echo "warning: EMERGENCY_TEMP must be 70-100" >&2; return 1; }

    for i in "${!CT[@]}"; do CT[i]=$(( CT[i] * 1000 )); done
    HYST_MC=$(( HYST * 1000 ))
    EMERGENCY_TEMP_MC=$(( EMERGENCY_TEMP * 1000 ))
    if (( SILENT_OFF_BELOW > 0 )); then
        SILENT_OFF_BELOW_MC=$(( SILENT_OFF_BELOW * 1000 ))
    else
        SILENT_OFF_BELOW_MC=${CT[1]}
    fi

    GPU_CURVE_CUSTOM=0
    if (( ${#GPU_CT[@]} == 0 )); then
        (( ${#GPU_CP[@]} == 0 )) || { echo "warning: GPU_CP requires GPU_CT" >&2; return 1; }
        GPU_CT=("${CT[@]}")
        GPU_CP=("${CP[@]}")
    else
        if (( ${#GPU_CP[@]} != ${#GPU_CT[@]} )); then
            echo "warning: GPU_CT/GPU_CP array mismatch in $CONF" >&2
            return 1
        else
            if validate_curve GPU GPU_CT GPU_CP; then
                for i in "${!GPU_CT[@]}"; do GPU_CT[i]=$(( GPU_CT[i] * 1000 )); done
                GPU_CURVE_CUSTOM=1
            else
                return 1
            fi
        fi
    fi
    if (( SILENT_OFF_BELOW > 0 )); then
        GPU_SILENT_OFF_BELOW_MC=$SILENT_OFF_BELOW_MC
    else
        GPU_SILENT_OFF_BELOW_MC=${GPU_CT[1]}
    fi
}

load_conf() {
    local -a old_CT=("${CT[@]}") old_CP=("${CP[@]}")
    local -a old_GPU_CT=("${GPU_CT[@]}") old_GPU_CP=("${GPU_CP[@]}")
    local old_HYST=$HYST old_POLL_SEC=$POLL_SEC old_HYST_MC=$HYST_MC
    local old_FOLLOW=$FOLLOW_PLATFORM_PROFILE old_RPM=$RPM_STALL_WARN
    local old_SLEW_UP=$SLEW_UP old_SLEW_DOWN=$SLEW_DOWN old_MIN_PWM=$MIN_PWM
    local old_SILENT=$SILENT_OFF_BELOW old_SILENT_MC=$SILENT_OFF_BELOW_MC
    local old_GPU_SILENT_MC=$GPU_SILENT_OFF_BELOW_MC old_EMERGENCY=$EMERGENCY_TEMP
    local old_EMERGENCY_MC=$EMERGENCY_TEMP_MC old_GPU_CUSTOM=$GPU_CURVE_CUSTOM
    local valid=1

    set_defaults
    if [[ -f "$CONF" ]]; then
        conf_safe || valid=0
        (( ! valid )) || parse_conf || { echo "warning: failed to parse $CONF" >&2; valid=0; }
    fi
    (( ! valid )) || normalize_conf || valid=0

    if (( valid )); then
        CONFIG_LOADED=1
        return 0
    fi

    if (( CONFIG_LOADED )); then
        CT=("${old_CT[@]}"); CP=("${old_CP[@]}")
        GPU_CT=("${old_GPU_CT[@]}"); GPU_CP=("${old_GPU_CP[@]}")
        HYST=$old_HYST; POLL_SEC=$old_POLL_SEC; HYST_MC=$old_HYST_MC
        FOLLOW_PLATFORM_PROFILE=$old_FOLLOW; RPM_STALL_WARN=$old_RPM
        SLEW_UP=$old_SLEW_UP; SLEW_DOWN=$old_SLEW_DOWN; MIN_PWM=$old_MIN_PWM
        SILENT_OFF_BELOW=$old_SILENT; SILENT_OFF_BELOW_MC=$old_SILENT_MC
        GPU_SILENT_OFF_BELOW_MC=$old_GPU_SILENT_MC
        EMERGENCY_TEMP=$old_EMERGENCY; EMERGENCY_TEMP_MC=$old_EMERGENCY_MC
        GPU_CURVE_CUSTOM=$old_GPU_CUSTOM
        echo "warning: keeping last-known-good configuration" >&2
        return 1
    fi

    echo "warning: using built-in defaults" >&2
    set_defaults
    normalize_conf
    CONFIG_LOADED=1
    return 1
}

find_hwmon() {
    local f dir
    for f in "$SYSFS_ROOT"/class/hwmon/*/name; do
        [[ -f "$f" && "$(<"$f")" == hp ]] || continue
        dir=$(dirname "$f")
        [[ -e "$dir/pwm1" && -e "$dir/pwm1_enable" ]] && echo "$dir" && return
    done
}

find_gpu_temps() {
    local f temp_file name dir
    for f in "$SYSFS_ROOT"/class/hwmon/*/name; do
        [[ -f "$f" ]] || continue
        name=$(<"$f")
        dir=$(dirname "$f")
        case "$name" in
            nvidia|amdgpu|radeon)
                for temp_file in "$dir"/temp*_input; do
                    [[ -f "$temp_file" ]] && echo "$temp_file"
                done ;;
        esac
    done
}

find_cpu_temp() {
    local dir f lf
    # Intel coretemp: prefer "Package id 0" label over temp1 which may be a single core
    for dir in "$SYSFS_ROOT"/devices/platform/coretemp.*/hwmon/hwmon*; do
        [[ -d "$dir" ]] || continue
        for lf in "$dir"/temp*_label; do
            [[ -f "$lf" ]] || continue
            [[ "$(<"$lf")" == "Package id 0" ]] && echo "${lf/_label/_input}" && return
        done
        [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return
    done
    # AMD k10temp / zenpower: prefer Tdie (no offset) over Tctl which has +10°C on some Zen
    local name
    for f in "$SYSFS_ROOT"/class/hwmon/*/name; do
        [[ -f "$f" ]] || continue
        name=$(<"$f")
        [[ "$name" == "k10temp" || "$name" == "zenpower" ]] || continue
        dir=$(dirname "$f")
        for lf in "$dir"/temp*_label; do
            [[ -f "$lf" ]] || continue
            [[ "$(<"$lf")" == "Tdie" ]] && echo "${lf/_label/_input}" && return
        done
        [[ -f "$dir/temp1_input" ]] && echo "$dir/temp1_input" && return
    done
}

find_fan_inputs() {
    local f
    for f in "$HP_HWMON"/fan*_input; do
        [[ -f "$f" ]] && echo "$f"
    done
}

read_max_temp() {
    local path value max=0
    for path in "$@"; do
        value=$(cat "$path" 2>/dev/null) || continue
        [[ "$value" =~ ^[0-9]+$ ]] || continue
        (( value > 0 && value <= 150000 && value > max )) && max=$value
    done
    echo "$max"
}

control_temp() {
    (( $1 > $2 )) && echo "$1" || echo "$2"
}

profile_to_curves() {
    case "$1" in
        low-power)
            CT=(50000 60000 70000 82000 90000)
            CP=(0 20 60 150 255)
            HYST_MC=8000; POLL_SEC=4 ;;
        balanced)
            CT=(40000 50000 60000 72000 82000)
            CP=(0 30 80 170 255)
            HYST_MC=6000; POLL_SEC=2 ;;
        performance)
            CT=(35000 45000 58000 68000 78000)
            CP=(30 80 140 210 255)
            HYST_MC=4000; POLL_SEC=1 ;;
        *) return ;;
    esac
    if (( ! GPU_CURVE_CUSTOM )); then
        GPU_CT=("${CT[@]}")
        GPU_CP=("${CP[@]}")
    fi
    if (( SILENT_OFF_BELOW > 0 )); then
        SILENT_OFF_BELOW_MC=$(( SILENT_OFF_BELOW * 1000 ))
        GPU_SILENT_OFF_BELOW_MC=$SILENT_OFF_BELOW_MC
    else
        SILENT_OFF_BELOW_MC=${CT[1]}
        GPU_SILENT_OFF_BELOW_MC=${GPU_CT[1]}
    fi
}

apply() {
    if (( DRY_RUN )); then
        echo "dry-run: pwm=$1 (cpu=${2}mc gpu=${3}mc)" >&2
        return 0
    fi
    if ! echo "$1" > "$HP_HWMON/pwm1" 2>/dev/null; then
        echo "error: failed to write pwm=$1" >&2
        return 1
    fi
    local actual
    if ! actual=$(cat "$HP_HWMON/pwm1" 2>/dev/null) || [[ "$actual" != "$1" ]]; then
        echo "error: PWM write was not accepted (requested=$1 actual=${actual:-unreadable})" >&2
        return 1
    fi
}

set_manual_control() {
    (( DRY_RUN )) && return 0
    if ! echo 1 > "$HP_HWMON/pwm1_enable" 2>/dev/null; then
        echo "error: failed to enable manual fan control" >&2
        return 1
    fi
    local mode
    if ! mode=$(cat "$HP_HWMON/pwm1_enable" 2>/dev/null) || [[ "$mode" != "1" ]]; then
        echo "error: manual fan control request was not accepted (mode=${mode:-unreadable})" >&2
        return 1
    fi
}

set_firmware_control() {
    (( DRY_RUN )) && return 0
    if ! echo 2 > "$HP_HWMON/pwm1_enable" 2>/dev/null; then
        echo "error: failed to return fan control to firmware" >&2
        return 1
    fi
    local mode
    if ! mode=$(cat "$HP_HWMON/pwm1_enable" 2>/dev/null); then
        echo "error: could not verify firmware control mode" >&2
        return 1
    fi
    if [[ "$mode" != "2" ]]; then
        echo "error: firmware control request was not accepted (mode=$mode)" >&2
        return 1
    fi
}

acquire_lock() {
    (( DRY_RUN )) && return 0
    command -v flock >/dev/null 2>&1 || { echo "error: flock is required" >&2; return 1; }
    if [[ ! -d "${LOCK_FILE%/*}" ]]; then
        mkdir -p "${LOCK_FILE%/*}" 2>/dev/null || { echo "error: cannot create lock directory" >&2; return 1; }
    fi
    exec {LOCK_FD}> "$LOCK_FILE" || { echo "error: cannot open $LOCK_FILE" >&2; return 1; }
    if ! flock -n "$LOCK_FD"; then
        echo "error: another hpfand instance is already running" >&2
        return 1
    fi
}

start_inotify() {
    command -v inotifywait &>/dev/null || return
    [[ -f "$CONF" ]] || return
    ( inotifywait -q -m -e close_write,moved_to,create --format '%f' "$(dirname "$CONF")" 2>/dev/null | while read -r file; do
          [[ "$file" == "$(basename "$CONF")" ]] || continue
          kill -USR1 "$MAINPID" 2>/dev/null
      done ) &
    INOTIFY_PID=$!
}

on_reload() {
    echo "info: reloading conf" >&2
    load_conf
    last_up_temp=999999
    last_profile=""
    desired_pwm=$cur_pwm
}

cleanup() {
    [[ -n "$INOTIFY_PID" ]] && kill "$INOTIFY_PID" 2>/dev/null
    local rc=0
    [[ ! -d "$HP_HWMON" ]] || set_firmware_control || rc=1
    exit "$rc"
}

next_pwm() {
    local desired=$1 current=$2 starting=$3
    if (( desired > current + SLEW_UP )); then
        echo $(( current + SLEW_UP ))
    elif (( desired < current )); then
        if (( starting )); then echo "$current"
        elif (( desired < current - SLEW_DOWN )); then echo $(( current - SLEW_DOWN ))
        else echo "$desired"
        fi
    else
        echo "$desired"
    fi
}

update_desired_pwm() {
    local target=$1 effective_temp=$2
    if (( target > desired_pwm )); then
        desired_pwm=$target
        last_up_temp=$effective_temp
    elif (( target < desired_pwm && effective_temp <= last_up_temp - HYST_MC )); then
        desired_pwm=$target
    fi
}

iteration_done() {
    (( LOOP_LIMIT > 0 )) || return 1
    (( ++loop_count >= LOOP_LIMIT ))
}

check_config() {
    [[ -f "$CONF" ]] || { echo "error: config not found: $CONF" >&2; return 1; }
    set_defaults
    if ! conf_safe || ! parse_conf || ! normalize_conf; then
        echo "error: invalid configuration: $CONF" >&2
        return 1
    fi
    echo "configuration valid: $CONF"
}

main() {
(( CHECK_CONF )) && { check_config; return; }
acquire_lock || exit 1
HP_HWMON=$(find_hwmon)
CPU_TEMP=$(find_cpu_temp)
mapfile -t GPU_TEMPS < <(find_gpu_temps)

[[ -d "$HP_HWMON" ]] || { echo "hp-wmi hwmon not found" >&2; exit 1; }
if (( ! DRY_RUN )); then
    [[ -w "$HP_HWMON/pwm1" && -w "$HP_HWMON/pwm1_enable" ]] || { echo "hp-wmi PWM interface missing or not writable" >&2; exit 1; }
fi
[[ -f "$CPU_TEMP" ]] || { echo "cpu temp sensor not found (tried coretemp, k10temp, zenpower)" >&2; exit 1; }
mapfile -t FAN_INPUTS < <(find_fan_inputs)

load_conf

trap on_reload USR1
trap cleanup SIGTERM SIGINT

start_inotify

# Start from wherever the hardware already is — avoids jarring takeover on boot
cpu_temp_init=$(cat "$CPU_TEMP" 2>/dev/null)
if [[ "$cpu_temp_init" =~ ^[0-9]+$ ]] && (( cpu_temp_init > 0 && cpu_temp_init <= 150000 )); then
    ema_cpu=$cpu_temp_init
else
    ema_cpu=0
fi
last_up_temp=999999
cur_pwm_hw=$(cat "$HP_HWMON/pwm1" 2>/dev/null)
if [[ "$cur_pwm_hw" =~ ^[0-9]+$ ]] && (( cur_pwm_hw >= 0 && cur_pwm_hw <= 255 )); then
    cur_pwm=$cur_pwm_hw
else
    cur_pwm=255
fi
set_manual_control || exit 1
apply "$cur_pwm" "${cpu_temp_init:-0}" "0" || cleanup
echo "info: started — cpu=$(( ${cpu_temp_init:-0} / 1000 ))°C pwm=$cur_pwm" >&2

last_profile=""
desired_pwm=$cur_pwm
prev_pwm=$cur_pwm
stall_cycles=0
sensor_miss=0
emergency_active=0
ema_gpu=0
gpu_miss=0
startup_until=$(( EPOCHSECONDS + 30 ))
stall_active=0
stall_last_log=0
loop_count=0

while true; do
    if (( ! SKIP_SLEEP )); then
        sleep "$POLL_SEC" & wait $!
    fi

    if (( FOLLOW_PLATFORM_PROFILE )) && [[ -f "$SYSFS_ROOT/firmware/acpi/platform_profile" ]]; then
        prof=$(<"$SYSFS_ROOT/firmware/acpi/platform_profile")
        if [[ "$prof" != "$last_profile" ]]; then
            profile_to_curves "$prof"
            last_profile=$prof
            last_up_temp=999999
            echo "info: platform profile -> '$prof', updated fan curve" >&2
        fi
    fi

    cpu_temp=$(<"$CPU_TEMP")
    if [[ ! "$cpu_temp" =~ ^[0-9]+$ ]] || (( cpu_temp <= 0 || cpu_temp > 150000 )); then
        (( ++sensor_miss ))
        if (( sensor_miss >= 3 )); then
            if apply 255 0 0; then
                cur_pwm=255; prev_pwm=255; desired_pwm=255
                last_up_temp=999999
            fi
            (( sensor_miss == 3 )) && echo "warning: cpu temp unreadable — fan at full speed" >&2
        fi
        iteration_done && break
        continue
    fi
    sensor_miss=0

    if (( cpu_temp >= EMERGENCY_TEMP_MC )); then
        if apply 255 "$cpu_temp" 0; then
            cur_pwm=255; prev_pwm=255; desired_pwm=255
            last_up_temp=$cpu_temp
        fi
        (( emergency_active )) || echo "warning: emergency CPU temperature — fan at full speed (${cpu_temp}mc)" >&2
        emergency_active=1
        iteration_done && break
        continue
    fi

    if (( EPOCHSECONDS < startup_until )); then
        ema_cpu=$(( (8 * cpu_temp + 2 * ema_cpu) / 10 ))
    else
        ema_cpu=$(( (3 * cpu_temp + 7 * ema_cpu) / 10 ))
    fi

    if (( ${#GPU_TEMPS[@]} == 0 )); then
        mapfile -t GPU_TEMPS < <(find_gpu_temps)
    fi
    gpu_temp=$(read_max_temp "${GPU_TEMPS[@]}")
    if (( gpu_temp == 0 )); then
        mapfile -t GPU_TEMPS < <(find_gpu_temps)
        gpu_temp=$(read_max_temp "${GPU_TEMPS[@]}")
    fi
    if [[ "$gpu_temp" =~ ^[0-9]+$ ]] && (( gpu_temp > 0 && gpu_temp <= 150000 )); then
        gpu_miss=0
        if (( EPOCHSECONDS < startup_until )); then
            ema_gpu=$(( (8 * gpu_temp + 2 * ema_gpu) / 10 ))
        else
            ema_gpu=$(( (3 * gpu_temp + 7 * ema_gpu) / 10 ))
        fi
    elif (( ema_gpu > 0 && gpu_miss < 3 )); then
        (( gpu_miss++ ))
    else
        ema_gpu=0
        gpu_miss=0
    fi

    if (( gpu_temp >= EMERGENCY_TEMP_MC )); then
        if apply 255 "$cpu_temp" "$gpu_temp"; then
            cur_pwm=255; prev_pwm=255; desired_pwm=255
            last_up_temp=$gpu_temp
        fi
        (( emergency_active )) || echo "warning: emergency GPU temperature — fan at full speed (${gpu_temp}mc)" >&2
        emergency_active=1
        iteration_done && break
        continue
    fi
    if (( emergency_active )); then
        echo "info: temperatures below emergency threshold — resuming configured curve" >&2
        emergency_active=0
    fi

    cpu_control_temp=$(control_temp "$cpu_temp" "$ema_cpu")
    gpu_control_temp=$(control_temp "$gpu_temp" "$ema_gpu")
    cpu_target=$(pwm_for_temp CT CP "$cpu_control_temp")
    gpu_target=0
    (( gpu_control_temp > 0 )) && gpu_target=$(pwm_for_temp GPU_CT GPU_CP "$gpu_control_temp")
    target=$(( cpu_target > gpu_target ? cpu_target : gpu_target ))

    if [[ -f "$SILENT_FLAG" ]]; then
        (( cpu_control_temp < SILENT_OFF_BELOW_MC && (gpu_control_temp == 0 || gpu_control_temp < GPU_SILENT_OFF_BELOW_MC) )) && target=0
    fi
    (( stall_active )) && target=255

    effective_temp=$(( cpu_control_temp > gpu_control_temp ? cpu_control_temp : gpu_control_temp ))

    update_desired_pwm "$target" "$effective_temp"

    candidate_pwm=$(next_pwm "$desired_pwm" "$cur_pwm" "$(( EPOCHSECONDS < startup_until ))")

    (( MIN_PWM > 0 && candidate_pwm > 0 && candidate_pwm < MIN_PWM )) && candidate_pwm=$MIN_PWM

    if (( candidate_pwm != prev_pwm )); then
        if apply "$candidate_pwm" "$ema_cpu" "$ema_gpu"; then
            cur_pwm=$candidate_pwm
            prev_pwm=$candidate_pwm
        fi
    fi

    if (( RPM_STALL_WARN && cur_pwm > 80 )); then
        (( stall_cycles++ ))
        if (( stall_cycles >= 5 || stall_active )); then
            (( ${#FAN_INPUTS[@]} > 0 )) || mapfile -t FAN_INPUTS < <(find_fan_inputs)
            stalled=0
            log_stall=0
            if (( ! stall_active || EPOCHSECONDS - stall_last_log >= 30 )); then
                log_stall=1
            fi
            for fan_path in "${FAN_INPUTS[@]}"; do
                fan_rpm=$(cat "$fan_path" 2>/dev/null) || continue
                if [[ "$fan_rpm" =~ ^[0-9]+$ ]] && (( fan_rpm < 200 )); then
                    (( log_stall )) && echo "warning: $(basename "$fan_path" _input) may be stalled — pwm=$cur_pwm but rpm=$fan_rpm" >&2
                    stalled=1
                fi
            done
            if (( stalled )); then
                (( log_stall )) && stall_last_log=$EPOCHSECONDS
                stall_active=1
                if apply 255 "$ema_cpu" "$ema_gpu"; then
                    cur_pwm=255; prev_pwm=255; desired_pwm=255
                    last_up_temp=999999
                fi
            elif (( stall_active )); then
                echo "info: fan RPM recovered — resuming configured curve" >&2
                stall_active=0
            fi
            stall_cycles=0
        fi
    else
        stall_cycles=0
    fi
    iteration_done && break
done
cleanup
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
